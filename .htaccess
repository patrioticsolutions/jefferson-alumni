Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<FilesMatch "^(\.env|config(\.local)?\.php|.*\.(json|sql|ps1|md|yml))$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^api(?:/.*)?$ api.php [QSA,L]
RewriteRule ^calendar\.ics$ api.php [QSA,L]
RewriteRule ^(uploads|event-uploads|home-post-assets|site-assets)/[A-Za-z0-9_-]+\.(png|jpg|webp)$ media.php [QSA,L]
RewriteRule ^community/?$ community.html [QSA,L]
